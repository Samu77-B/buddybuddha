# Stripe secret key (test: sk_test_..., live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_REPLACE

# Where to send the customer after payment
SUCCESS_URL=https://www.yoursite.com/cart.html?success=1
CANCEL_URL=https://www.yoursite.com/cart.html

# Comma-separated site origins allowed to call this API (your Hostinger domain)
ALLOWED_ORIGINS=https://www.yoursite.com,https://yoursite.com,http://localhost:8000

# Optional: enable Stripe Tax (configure in Stripe Dashboard first)
STRIPE_AUTOMATIC_TAX=false

# Shipping countries (ISO codes, comma-separated)
SHIPPING_COUNTRIES=GB,IE,US,CA,AU,NZ

PORT=4242
